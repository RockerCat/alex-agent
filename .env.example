# AlexAgent v0.1 — environment configuration
# Copy to .env.local for local development. Never commit the real file.

# --- Supabase -----------------------------------------------------------
# Project URL and anon (publishable) key — safe to expose to the browser,
# used for session-aware auth on the client and in middleware.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Grants full database access, bypassing
# RLS. Never prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI --------------------------------------------------------------
# SERVER ONLY. Never expose via NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=

# Confirmed production models (spec section 5). Model ids are configurable
# so they can be changed without touching the runtime — these are the
# defaults baked into lib/env.ts; setting them here is optional unless you
# need to override. Exact pricing for both is registered in
# lib/agent/pricing.ts; keep the two in sync if either model id changes.
OPENAI_PLANNER_MODEL=gpt-5.6-sol
OPENAI_EXECUTOR_MODEL=gpt-5.6-luna

# Optional and disabled by default — leave unset. Live evidence: the
# confirmed gpt-5.6-sol Planner model rejects the Responses API
# `reasoning.effort` param outright ("400 Unsupported parameter:
# 'reasoning.effort' is not supported with this model."). Absent or
# empty, no `reasoning` parameter is sent at all. Only set this if you
# have verified against the live API that your configured
# OPENAI_PLANNER_MODEL actually accepts it — do not assume support from
# a model name or version. Valid values if you do:
# none | minimal | low | medium | high | xhigh | max.
OPENAI_PLANNER_REASONING_EFFORT=

# --- Auth ------------------------------------------------------------------
# Optional defense-in-depth: if set, only this exact Supabase Auth user
# email is allowed in (in addition to needing a valid session). Leave
# unset to allow any authenticated user in the Supabase project.
OWNER_EMAIL=
